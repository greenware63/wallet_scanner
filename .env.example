# Copy this file to `.env` and fill in the values you need.
# `.env` is loaded automatically by the scanners (tron, solana, ton, ethereum)
# via python-dotenv (optional dependency, falls back to OS environment
# variables if not installed). Never commit your real `.env` file.

# ---- TRON scanner (tron_scanner.py) ----
# Optional: higher rate limits on TronGrid. Get a free key at https://www.trongrid.io/
TRONGRID_API_KEY=

# ---- Solana scanner (solana_scanner.py) ----
# Optional: use a private RPC instead of the heavily rate-limited public endpoint.
# Free Helius key: https://dev.helius.xyz/
HELIUS_API_KEY=
QUICKNODE_SOLANA_URL=
TRITON_RPC_URL=

# ---- TON scanner (ton_scanner.py) ----
# Optional: higher rate limits on TON Center (10 req/s vs 1 req/s).
# Get a free key from @tonapibot or https://toncenter.com/
TONCENTER_API_KEY=

# ---- Ethereum scanner (ethereum_scanner.py) ----
# Optional: higher rate limits with Etherscan API key (5 req/s).
# Get a free key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
